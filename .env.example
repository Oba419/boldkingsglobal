# ─── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Change for your own PostgreSQL server.
DATABASE_URL="postgresql://bkg:bkg_dev_password@localhost:5432/boldkings"
# Optional: direct (non-pooled) connection used only for migrations. Set this
# when DATABASE_URL is a pooled URL (e.g. Neon "-pooler" host, PgBouncer).
DIRECT_DATABASE_URL=""
# Optional: maximum pooled connections per server instance (pg default: 10).
DATABASE_POOL_MAX=""

# ─── Application ─────────────────────────────────────────────────────────────
# Public base URL (used for canonical links, sitemap, payment callbacks).
APP_URL="http://localhost:3000"

# Long random string (min 32 chars). Signs sessions and guest order-access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# ─── First administrator (used only by `npm run admin:create`) ───────────────
# Remove these from the environment after provisioning.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ─── Online payments: Paystack (optional) ────────────────────────────────────
# Leave empty to keep online payment disabled. Use test keys (sk_test_...) first.
PAYSTACK_SECRET_KEY=""
